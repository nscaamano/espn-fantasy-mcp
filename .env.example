# ESPN private-league cookies. Copy from browser dev tools while logged in to
# fantasy.espn.com: Application → Cookies → https://fantasy.espn.com.
# espn_s2 expires periodically; re-copy it when calls start returning 401s.
ESPN_S2=
# Include the curly braces, e.g. {ABCD1234-...}
SWID=

# Optional overrides
# ESPN_BASE_URL=https://lm-api-reads.fantasy.espn.com/apis/v3
# LEAGUES_CONFIG=/absolute/path/to/leagues.json
